+// Benchmark observers; production compile/render/event scheduling stays intact.
+static unsigned bench_revision;
+static bool bench_ready, bench_snapshot;
+static double bench_now(void)
+{
+#ifdef __APPLE__
+  static mach_timebase_info_data_t timebase;
+  if (!timebase.denom) mach_timebase_info(&timebase);
+  return (double)mach_absolute_time() * timebase.numer / timebase.denom / 1000000.0;
+#else
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
+#endif
+}
+
 static void render(fz_context *ctx, ui_state *ui)
 {
   SDL_SetRenderDrawColor(ui->sdl_renderer, 0, 0, 0, 255);
   SDL_RenderClear(ui->sdl_renderer);
   txp_renderer_render(ctx, ui->doc_renderer);
+  double submitted = bench_now();
+  if (bench_ready && bench_revision) {
+    int w, h; SDL_GetRendererOutputSize(ui->sdl_renderer, &w, &h);
+    SDL_FRect page; float scale;
+    txp_renderer_page_position(ctx, ui->doc_renderer, &page, NULL, &scale);
+    SDL_RendererInfo info; SDL_GetRendererInfo(ui->sdl_renderer, &info);
+    fprintf(stderr, "REX_BENCH {\"type\":\"draw\",\"revision\":%u,\"now\":%.6f,\"viewport\":[%d,%d],\"pagePixels\":[%.6f,%.6f],\"scale\":%.9f,\"renderer\":\"%s\",\"flags\":%u}\n",
+      bench_revision, submitted, w, h, page.w, page.h, scale, info.name, info.flags);
+    bench_ready = false;
+  }
+  if (bench_snapshot && txp_renderer_get_contents(ctx, ui->doc_renderer)) {
+    int w, h; SDL_GetRendererOutputSize(ui->sdl_renderer, &w, &h);
+    unsigned char *pixels = malloc(w * h * 4);
+    if (SDL_RenderReadPixels(ui->sdl_renderer, NULL, SDL_PIXELFORMAT_ARGB8888, pixels, w * 4)) abort();
+    unsigned long pixel_hash = crc32(0, pixels, w * h * 4); free(pixels);
+    fz_buffer *buffer = fz_new_buffer(ctx, 4096);
+    fz_output *output = fz_new_output_with_buffer(ctx, buffer);
+    fz_device *device = fz_new_trace_device(ctx, output);
+    fz_run_display_list(ctx, txp_renderer_get_contents(ctx, ui->doc_renderer), device, fz_identity, fz_infinite_rect, NULL);
+    fz_close_device(ctx, device); fz_drop_device(ctx, device);
+    fz_close_output(ctx, output); fz_drop_output(ctx, output);
+    unsigned char *data; size_t length = fz_buffer_storage(ctx, buffer, &data);
+    unsigned long trace_hash = crc32(0, data, length);
+    fprintf(stderr, "REX_BENCH {\"type\":\"snapshot\",\"revision\":%u,\"pixels\":%lu,\"trace\":%lu,\"traceBytes\":%zu}\n",
+      bench_revision, pixel_hash, trace_hash, length);
+    fz_drop_buffer(ctx, buffer); bench_snapshot = false;
+  }
   SDL_RenderPresent(ui->sdl_renderer);
 }
 
