{
  "name": "rex-browser-tex",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prune-deps.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:bibliography": "node scripts/setup.mjs --bibliography",
    "setup:chinese": "node scripts/setup.mjs --chinese",
    "dev": "node scripts/serve.mjs --source",
    "build": "node scripts/build.mjs",
    "build:tools": "bash scripts/build-busytex.sh",
    "build:hosted": "node scripts/build.mjs --hosted",
    "release": "npm run build && node scripts/release.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:deps": "node scripts/prune-deps.mjs",
    "clean:assets": "node scripts/prune-assets.mjs",
    "start": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:browser": "node tests/browser/editor.mjs",
    "test:startup": "node tests/browser/startup.mjs",
    "test:startup-speed": "node tests/browser/startup-speed.mjs",
    "test:theme": "node tests/browser/theme.mjs",
    "test:webkit": "node tests/browser/webkit.mjs",
    "test:static": "node tests/browser/offline.mjs",
    "test:full": "node tests/browser/full.mjs",
    "test:chinese": "node tests/browser/chinese.mjs",
    "test:all": "npm run check && npm test && npm run test:startup-speed && npm run test:startup && npm run test:loading && npm run test:local-worker && npm run test:theme && npm run test:ui && npm run test:browser && npm run test:static && npm run test:webkit && npm run test:full && npm run test:chinese",
    "bench": "node benchmarks/benchmark.mjs",
    "bench:compare": "node benchmarks/compare.mjs",
    "bench:texlode": "node benchmarks/texlode.mjs",
    "test:ui": "node tests/browser/ui.mjs",
    "test:loading": "node tests/browser/loading.mjs",
    "test:local-worker": "node tests/browser/local-worker.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "opentype.js": "1.3.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "binaryen": "132.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.51.1"
  },
  "description": "Browser-native LaTeX editing with persistent LuaTeX WASM workers",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
